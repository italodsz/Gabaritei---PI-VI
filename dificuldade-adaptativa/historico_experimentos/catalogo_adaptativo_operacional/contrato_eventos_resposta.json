{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gabaritei evento de resposta v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "evento_id", "origem", "estudante_pseudonimo", "sessao_id",
    "questao_id", "grupo_variantes", "catalogo_versao", "modelo_versao", "area",
    "escala_dificuldade", "faixa_dificuldade", "ocorrido_em", "duracao_ms", "tentativa",
    "alternativa", "correta", "modo", "recomendacao_id", "preferencia_dificuldade", "aceitou_oferta"],
  "properties": {
    "versao": {"const": 1},
    "evento_id": {"type":"string","format":"uuid"},
    "origem": {"enum":["piloto_real","simulacao"]},
    "estudante_pseudonimo": {"type":"string","minLength":8},
    "sessao_id": {"type":"string","minLength":1},
    "questao_id": {"type":"string","pattern":"^gq_[0-9a-f]{24}$"},
    "grupo_variantes": {"type":"string","minLength":1},
    "catalogo_versao": {"type":"string","minLength":1},
    "modelo_versao": {"type":"string","minLength":1},
    "area": {"enum":["CH","CN","LC","MT"]},
    "escala_dificuldade": {"type":["string","null"]},
    "faixa_dificuldade": {"enum":["b_relativo_baixo","b_relativo_medio","b_relativo_alto",null]},
    "ocorrido_em": {"type":"string","format":"date-time"},
    "duracao_ms": {"type":"integer","minimum":0},
    "tentativa": {"type":"integer","minimum":1},
    "alternativa": {"enum":["A","B","C","D","E"]},
    "correta": {"type":"boolean"},
    "modo": {"enum":["escolha_livre","oferta_aceita","oferta_recusada","sem_oferta"]},
    "recomendacao_id": {"type":["string","null"]},
    "preferencia_dificuldade": {"enum":["baixo","medio","alto","livre",null]},
    "aceitou_oferta": {"type":["boolean","null"]}
  },
  "allOf": [
    {"if":{"properties":{"faixa_dificuldade":{"type":"null"}}},
     "then":{"properties":{"escala_dificuldade":{"type":"null"}}},
     "else":{"properties":{"escala_dificuldade":{"type":"string","minLength":1}}}},
    {"if":{"properties":{"modo":{"const":"oferta_aceita"}}},
     "then":{"properties":{"aceitou_oferta":{"const":true},"recomendacao_id":{"type":"string","minLength":1}}}},
    {"if":{"properties":{"modo":{"const":"oferta_recusada"}}},
     "then":{"properties":{"aceitou_oferta":{"const":false},"recomendacao_id":{"type":"string","minLength":1}}}},
    {"if":{"properties":{"modo":{"enum":["escolha_livre","sem_oferta"]}}},
     "then":{"properties":{"aceitou_oferta":{"type":"null"}}}}
  ]
}
