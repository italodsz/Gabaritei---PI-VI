  perfil_tri_historico -> resposta_evento [style=invis, weight=10];
  resposta_evento -> migracao [style=invis, weight=10];
  sessao_login -> sessao_pratica [style=invis, weight=50];
  sessao_pratica -> resposta_pratica [style=invis, weight=50];
  resposta_pratica -> atividade_plano [style=invis, weight=50];
  atividade_plano -> questao [style=invis, weight=50];
  usuario -> simulado [style=invis, weight=50];
  simulado -> resposta_simulado [style=invis, weight=50];
  resposta_simulado -> nota_bloco [style=invis, weight=50];
  nota_bloco -> perfil_tri_historico [style=invis, weight=50];
  estado_usuario -> favorita [style=invis, weight=50];
  favorita -> meta [style=invis, weight=50];
  meta -> perfil_tri [style=invis, weight=50];
  perfil_tri -> resposta_evento [style=invis, weight=50];
  conta_estudos -> marca_revisao [style=invis, weight=50];
  marca_revisao -> conquista_celebrada [style=invis, weight=50];
  conquista_celebrada -> config_dificuldade [style=invis, weight=50];
  config_dificuldade -> migracao [style=invis, weight=50];
  usuario -> atividade_plano [arrowhead=crowodot, constraint=false];
  usuario -> conquista_celebrada [arrowhead=crowodot, constraint=false];
  usuario -> conta_estudos [arrowhead=teeodot, constraint=false];
  usuario -> estado_usuario [arrowhead=crowodot, constraint=false];
