  usuario -> marca_revisao [arrowhead=crowodot, constraint=false];
  usuario -> meta [arrowhead=crowodot, constraint=false];
  usuario -> nota_bloco [arrowhead=crowodot, constraint=false];
  config_dificuldade -> perfil_tri [arrowhead=crowodot, constraint=false];
  usuario -> perfil_tri [arrowhead=crowodot, constraint=false];
  usuario -> perfil_tri_historico [arrowhead=crowodot, constraint=false];
  config_dificuldade -> resposta_evento [arrowhead=crowodot, constraint=false];
  usuario -> resposta_evento [arrowhead=crowodot, constraint=false];
  sessao_pratica -> resposta_pratica [arrowhead=crowodot, constraint=false];
  simulado -> resposta_simulado [arrowhead=crowodot, constraint=false];
  usuario -> sessao_login [arrowhead=crowodot, constraint=false];
