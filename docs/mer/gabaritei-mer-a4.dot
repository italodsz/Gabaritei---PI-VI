digraph MER {
  graph [rankdir=TB, fontname="Helvetica", fontsize=18, nodesep=0.35, ranksep=0.55, pad=0.3, bgcolor="white", splines=true, size="7.9,11.3", ratio=compress, labelloc=t, label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="2"><TR><TD COLSPAN="6"><B>Gabaritei — MER físico (SQLite, migrações 0001–0003)</B></TD></TR><TR><TD COLSPAN="6"><FONT POINT-SIZE="11">PK chave primária · FK chave estrangeira · UK única · ? pode ser nulo · LQ = liga à questão do arquivo (sem FK)</FONT></TD></TR><TR><TD BGCOLOR="#2856b6"><FONT COLOR="white" POINT-SIZE="10"> Contas e acesso </FONT></TD><TD BGCOLOR="#226b47"><FONT COLOR="white" POINT-SIZE="10"> Estudos do aluno </FONT></TD><TD BGCOLOR="#914315"><FONT COLOR="white" POINT-SIZE="10"> Plano e notas </FONT></TD><TD BGCOLOR="#6b3fa0"><FONT COLOR="white" POINT-SIZE="10"> Recomendador de dificuldade (TRI) </FONT></TD><TD BGCOLOR="#555555"><FONT COLOR="white" POINT-SIZE="10"> Controle </FONT></TD><TD BGCOLOR="#999999"><FONT COLOR="white"><FONT POINT-SIZE="10"> Arquivo de questões (fora do banco) </FONT></FONT></TD></TR></TABLE>>];
