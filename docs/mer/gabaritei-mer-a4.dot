  resposta_evento [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#6b3fa0"><TR><TD COLSPAN="3" BGCOLOR="#6b3fa0" PORT="top"><FONT COLOR="white"><B>resposta_evento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="questao_id">questao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0"><FONT COLOR="#888888">LQ</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="area">area</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="alternativa">alternativa<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="correta">correta</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="tempo_ms">tempo_ms<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="primeira">primeira</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="apoio">apoio</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="origem">origem</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="chance_prevista">chance_prevista<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="theta_media">theta_media<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="theta_dp">theta_dp<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="pstar">pstar<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="conta">conta</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="motivo">motivo<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="versao_config">versao_config</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="criada_em">criada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  migracao [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#555555" PORT="top"><FONT COLOR="white"><B>migracao</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="versao"><B>versao</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="aplicada_em">aplicada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  questao [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#999999"><TR><TD COLSPAN="2" BGCOLOR="#999999" PORT="top"><FONT COLOR="white"><B>Questão (questions.jsonl)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B> (gq_...)</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">área, matéria, título, assunto</TD><TD></TD></TR><TR><TD ALIGN="LEFT">enunciado, alternativas,</TD><TD></TD></TR><TR><TD ALIGN="LEFT">gabarito, parâmetros TRI</TD><TD></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eeeeee"><I>catálogo titulo_area:</I></TD><TD BGCOLOR="#eeeeee"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eeeeee"><I>até 50 parecidas por questão</I></TD><TD BGCOLOR="#eeeeee"></TD></TR></TABLE>>];
  { rank=same; sessao_login; usuario; estado_usuario; conta_estudos }
  sessao_login -> usuario [style=invis, weight=10];
  usuario -> estado_usuario [style=invis, weight=10];
  estado_usuario -> conta_estudos [style=invis, weight=10];
  { rank=same; sessao_pratica; simulado; favorita; marca_revisao }
  sessao_pratica -> simulado [style=invis, weight=10];
  simulado -> favorita [style=invis, weight=10];
  favorita -> marca_revisao [style=invis, weight=10];
  { rank=same; resposta_pratica; resposta_simulado; meta; conquista_celebrada }
  resposta_pratica -> resposta_simulado [style=invis, weight=10];
  resposta_simulado -> meta [style=invis, weight=10];
  meta -> conquista_celebrada [style=invis, weight=10];
  { rank=same; atividade_plano; nota_bloco; perfil_tri; config_dificuldade }
