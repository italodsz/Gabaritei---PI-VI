    perfil_tri_historico [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#6b3fa0"><TR><TD COLSPAN="3" BGCOLOR="#6b3fa0" PORT="top"><FONT COLOR="white"><B>perfil_tri_historico</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id"><B>usuario_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="area"><B>area</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dia"><B>dia</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nota">nota<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="nota_min">nota_min<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="nota_max">nota_max<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="n">n</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
    resposta_evento [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#6b3fa0"><TR><TD COLSPAN="3" BGCOLOR="#6b3fa0" PORT="top"><FONT COLOR="white"><B>resposta_evento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="questao_id">questao_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="area">area</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="alternativa">alternativa<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="correta">correta</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="tempo_ms">tempo_ms<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="primeira">primeira</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="apoio">apoio</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="origem">origem</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="chance_prevista">chance_prevista<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="theta_media">theta_media<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="theta_dp">theta_dp<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="pstar">pstar<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">real</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="conta">conta</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="motivo">motivo<FONT COLOR="#888888"> ?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="versao_config">versao_config</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="criada_em">criada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
    config_dificuldade [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#6b3fa0"><TR><TD COLSPAN="3" BGCOLOR="#6b3fa0" PORT="top"><FONT COLOR="white"><B>config_dificuldade</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="versao"><B>versao</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b3fa0">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sha256">sha256</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="conteudo">conteudo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="registrada_em">registrada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  }
  subgraph cluster_4 { label=<<B>Controle</B>>; color="#555555"; fontcolor="#555555"; style="rounded"; margin=14;
    migracao [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#555555" PORT="top"><FONT COLOR="white"><B>migracao</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="versao"><B>versao</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="aplicada_em">aplicada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  }
  subgraph cluster_ext { label=<<B>Arquivos (fora do banco)</B>>; color="#999999"; fontcolor="#777777"; style="rounded,dashed";
    questao [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#999999"><TR><TD COLSPAN="2" BGCOLOR="#999999"><FONT COLOR="white"><B>Questão (questions.jsonl)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B> (gq_...)</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">área, matéria, título, assunto</TD><TD></TD></TR><TR><TD ALIGN="LEFT">enunciado, alternativas, gabarito, TRI</TD><TD></TD></TR></TABLE>>];
    catalogo [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#999999"><TR><TD BGCOLOR="#999999"><FONT COLOR="white"><B>Catálogo titulo_area</B></FONT></TD></TR><TR><TD ALIGN="LEFT">questão → até 50 parecidas, em ordem</TD></TR></TABLE>>];  }
  usuario:s -> atividade_plano:top:n [arrowtail=tee, arrowhead=crowodot, tooltip="atividade_plano.usuario_id → usuario"];
