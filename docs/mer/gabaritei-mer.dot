digraph MER {
  graph [rankdir=TB, newrank=true, fontname="Helvetica", fontsize=16, nodesep=0.3, ranksep=1.2, pad=0.4, bgcolor="white", label=<<B>Gabaritei — MER físico (SQLite, migrações 0001–0003)</B><BR/><FONT POINT-SIZE="11">PK chave primária · FK chave estrangeira · UK única · ? pode ser nulo · tracejado = referência lógica a arquivo</FONT>>, labelloc=t];
