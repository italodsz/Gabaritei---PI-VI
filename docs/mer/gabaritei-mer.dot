  usuario:s -> sessao_pratica:top:n [arrowtail=tee, arrowhead=crowodot, tooltip="sessao_pratica.usuario_id → usuario"];
  usuario:s -> simulado:top:n [arrowtail=tee, arrowhead=crowodot, tooltip="simulado.usuario_id → usuario"];
  questao:id -> resposta_pratica:questao_id [style=dashed, color="#999999", arrowtail=tee, arrowhead=crowodot, constraint=false];
  questao:id -> resposta_simulado:questao_id [style=dashed, color="#999999", arrowtail=tee, arrowhead=crowodot, constraint=false];
  questao:id -> resposta_evento:questao_id [style=dashed, color="#999999", arrowtail=tee, arrowhead=crowodot, constraint=false];
  questao:id -> favorita:questao_id [style=dashed, color="#999999", arrowtail=tee, arrowhead=crowodot, constraint=false];
  questao:id -> marca_revisao:questao_id [style=dashed, color="#999999", arrowtail=tee, arrowhead=crowodot, constraint=false];
  catalogo -> questao [style=dashed, color="#999999", dir=forward, arrowhead=normal, label=" parecidas"];
}