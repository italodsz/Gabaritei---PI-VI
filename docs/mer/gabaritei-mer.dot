  usuario:s -> perfil_tri:top:n [arrowtail=tee, arrowhead=crowodot, tooltip="perfil_tri.usuario_id → usuario"];
  usuario:s -> perfil_tri_historico:top:n [arrowtail=tee, arrowhead=crowodot, tooltip="perfil_tri_historico.usuario_id → usuario"];
  config_dificuldade:s -> resposta_evento:top:n [arrowtail=tee, arrowhead=crowodot, tooltip="resposta_evento.versao_config → config_dificuldade"];
  usuario:s -> resposta_evento:top:n [arrowtail=tee, arrowhead=crowodot, tooltip="resposta_evento.usuario_id → usuario"];
  sessao_pratica:s -> resposta_pratica:top:n [arrowtail=tee, arrowhead=crowodot, tooltip="resposta_pratica.sessao_id → sessao_pratica"];
  simulado:s -> resposta_simulado:top:n [arrowtail=tee, arrowhead=crowodot, tooltip="resposta_simulado.simulado_id → simulado"];
